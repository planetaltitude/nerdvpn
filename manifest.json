{
  "manifest_version": 3,
  "name": "NerdVPN",
  "version": "1.0.0",
  "description": "Redirects visits to X and Reddit to alternative domains.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*",
    "*://reddit.com/*",
    "*://www.reddit.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirects",
        "enabled": true,
        "path": "rules/redirects.json"
      }
    ]
  }
}
