{
  "manifest_version": 3,
  "name": "NerdVPN",
  "version": "1.0.0",
  "description": "Redirects visits to X and Reddit to alternative domains.",
  "action": {
    "default_popup": "background.html",
    "default_title": "NerdVPN redirects"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*",
    "*://reddit.com/*",
    "*://www.reddit.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "xRedirects",
        "enabled": true,
        "path": "rules/x_redirects.json"
      },
      {
        "id": "redditRedirects",
        "enabled": true,
        "path": "rules/reddit_redirects.json"
      }
    ]
  }
}
